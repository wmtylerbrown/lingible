#!/usr/bin/env bash
# Local/CI verification for Lingible. Runs the same checks `.github/workflows/verify.yml` runs.
#
# backend/lambda's Python toolchain matches the `allong` project's (uv + ruff + nox, `uv.lock`
# hash-verified by default) -- see specs/backend-python-toolchain.md. The CDK app remains a plain
# `npm run build` (tsc); nox does not cover it, since it's a different language toolchain.
#
# This script validates only. It never deploys -- `npm run deploy:dev` / `npm run deploy:prod`
# from backend/cdk/ remain the only path to AWS (docs/development/AGENT_PROTOCOL.md "Deploys stay
# separate from CI").
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

echo "== Lingible verification =="

if ! command -v uv >/dev/null 2>&1; then
  echo "ERROR: uv is required (backend/lambda uses uv); verification cannot run." >&2
  exit 1
fi

echo "-- backend/lambda: uv sync --"
UV_PROJECT_ENVIRONMENT="$ROOT/.venv" uv sync --project backend/lambda --all-extras

echo "-- backend/lambda: nox (lint, typecheck, test) --"
"$ROOT/.venv/bin/nox" -s lint typecheck test

if ! command -v npm >/dev/null 2>&1; then
  echo "ERROR: npm is required (backend/cdk); verification cannot run." >&2
  exit 1
fi

echo "-- backend/cdk: npm install --"
(cd backend/cdk && npm install --no-audit --no-fund)

echo "-- backend/cdk: build (tsc) --"
(cd backend/cdk && npm run build)

echo "-- backend/cdk: verify-bedrock-resources --"
(cd backend/cdk && npm run test)

echo "-- spec consistency --"
python3 scripts/check_specs.py

echo "-- Bedrock cost review --"
python3 scripts/check_bedrock_cost_review.py

echo "== PASS =="
