#!/usr/bin/env bash
# Local/CI verification for Lingible. Runs the same checks `.github/workflows/verify.yml` runs.
#
# Unlike the `allong` project's `scripts/verify` (uv + nox + a hash-locked toolchain), Lingible
# still uses Poetry for the backend and a plain `npm run build` (tsc) for the CDK app -- this
# script is deliberately simple rather than a straight port. See issue tracking a possible future
# move to a locked toolchain (uv/ruff/nox) to match `allong`, if that's ever wanted here.
#
# This script validates only. It never deploys -- `npm run deploy:dev` / `npm run deploy:prod`
# from backend/cdk/ remain the only path to AWS (docs/development/AGENT_PROTOCOL.md "Deploys stay
# separate from CI").
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

echo "== Lingible verification =="

if ! command -v poetry >/dev/null 2>&1; then
  echo "ERROR: poetry is required (backend/lambda uses Poetry); verification cannot run." >&2
  exit 1
fi

echo "-- backend/lambda: poetry install --"
(cd backend/lambda && poetry install --no-interaction)

echo "-- backend/lambda: pytest --"
(cd backend/lambda && ENVIRONMENT=test PYTHONPATH=src poetry run pytest tests/ -q)

echo "-- backend/lambda: mypy --"
# --explicit-package-bases: backend/lambda/mypy.ini sets mypy_path = src (needed so bare imports
# like `from models.user import User` resolve, matching the PYTHONPATH=src convention in AGENTS.md)
# and src/ has its own __init__.py -- combined, a plain `mypy src/` reaches every file two ways
# ("src.models.x" via the __init__.py chain, "models.x" via mypy_path) and mypy refuses with
# "Source file found twice under different module names". This flag tells mypy to trust each file's
# nearest explicit package base instead of resolving both paths. Confirmed as the actual fix (not a
# workaround) locally: without it, `mypy src/` fails on every invocation regardless of which files
# changed; with it, a clean run reports "Success: no issues found in 95 source files".
(cd backend/lambda && poetry run mypy --explicit-package-bases src/)

echo "-- backend/lambda: flake8 --"
(cd backend/lambda && poetry run flake8 src/)

if ! command -v npm >/dev/null 2>&1; then
  echo "ERROR: npm is required (backend/cdk); verification cannot run." >&2
  exit 1
fi

echo "-- backend/cdk: npm install --"
(cd backend/cdk && npm install --no-audit --no-fund)

echo "-- backend/cdk: build (tsc) --"
(cd backend/cdk && npm run build)

echo "-- spec consistency --"
python3 scripts/check_specs.py

echo "-- Bedrock cost review --"
python3 scripts/check_bedrock_cost_review.py

echo "== PASS =="
